{
  "name": "vemians-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype Worker: public catalog on vemians.com, Access-gated ops on ops.vemians.com.",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:ops": "wrangler dev --env ops --port 8788",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "db:local": "bash migrations/apply-local.sh"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}
